<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fitzone_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/barreOutils"
        style="@style/FitZone.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:title="@string/seance_details_titre"
        app:navigationIcon="@drawable/ic_back" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/indicateurChargement"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contenuSeance"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/texteTitreSeance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="26sp"
                android:textColor="@color/fitzone_text_primary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/texteEcheanceSeance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/fitzone_text_secondary" />

            <TextView
                style="@style/FitZone.SectionTitle"
                android:text="@string/seance_statut" />

            <TextView
                android:id="@+id/texteStatutSeance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/texteDateSoumission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/fitzone_text_secondary"
                android:visibility="gone" />

            <TextView
                style="@style/FitZone.SectionTitle"
                android:text="@string/seance_description" />

            <TextView
                android:id="@+id/texteDescriptionSeance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp" />

            <TextView
                style="@style/FitZone.SectionTitle"
                android:text="@string/seance_consignes" />

            <TextView
                android:id="@+id/texteConsignesSeance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp" />

            <TextView
                style="@style/FitZone.SectionTitle"
                android:text="@string/seance_evaluation" />

            <TextView
                android:id="@+id/texteNoteSeance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/texteCommentaireSeance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/fitzone_text_secondary" />

            <TextView
                style="@style/FitZone.SectionTitle"
                android:text="@string/seance_soumission" />

            <TextView
                android:id="@+id/texteSoumissionVerrouillee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/fitzone_primary_soft"
                android:drawablePadding="10dp"
                android:padding="14dp"
                android:textColor="@color/fitzone_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:drawableStartCompat="@drawable/ic_session" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/conteneurSoumission"
                style="@style/FitZone.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/seance_contenu_indice">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/champSoumission"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:inputType="textMultiLine|textUri"
                    android:maxLines="6"
                    android:minLines="3" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/boutonSoumettre"
                style="@style/FitZone.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="24dp"
                android:text="@string/seance_marquer_soumise" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
