<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fitzone_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/barreOutils"
        style="@style/FitZone.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:title="@string/details_programme_titre"
        app:navigationIcon="@drawable/ic_back" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/indicateurChargement"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true" />

    <TextView
        android:id="@+id/texteErreur"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:gravity="center"
        android:textColor="@color/statut_en_retard"
        android:visibility="gone" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contenuProgramme"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/texteCodeProgramme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/fitzone_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/texteTitreProgramme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/fitzone_text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/texteCoachProgramme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/fitzone_text_primary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/texteSessionProgramme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/fitzone_text_secondary"
                android:textSize="14sp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/puceStatutProgramme"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clickable="false" />

            <TextView
                style="@style/FitZone.SectionTitle"
                android:text="@string/details_description" />

            <TextView
                android:id="@+id/texteDescriptionProgramme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/fitzone_text_secondary"
                android:textSize="16sp" />

            <TextView
                style="@style/FitZone.SectionTitle"
                android:text="@string/details_annonces" />

            <LinearLayout
                android:id="@+id/conteneurAnnoncesProgramme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                style="@style/FitZone.SectionTitle"
                android:text="@string/details_seances" />

            <TextView
                android:id="@+id/texteResumeSeances"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/fitzone_text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/boutonVoirSeances"
                style="@style/FitZone.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/details_voir_seances" />

            <TextView
                style="@style/FitZone.SectionTitle"
                android:text="@string/details_quiz" />

            <TextView
                android:id="@+id/texteResumeQuiz"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/fitzone_text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/boutonVoirQuiz"
                style="@style/FitZone.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/details_voir_quiz" />

            <TextView
                style="@style/FitZone.SectionTitle"
                android:text="@string/details_ressources" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/details_aucune_ressource"
                android:textColor="@color/fitzone_text_secondary" />

            <TextView
                style="@style/FitZone.SectionTitle"
                android:text="@string/details_notes" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="@string/details_aucune_note"
                android:textColor="@color/fitzone_text_secondary" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
