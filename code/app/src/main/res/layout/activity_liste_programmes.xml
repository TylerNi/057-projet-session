<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fitzone_surface"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        style="@style/FitZone.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:title="@string/programmes_titre" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/fitzone_surface"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="16dp">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/FitZone.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/programmes_recherche"
            app:boxBackgroundColor="@color/fitzone_surface_muted"
            app:boxStrokeWidth="0dp"
            app:boxStrokeWidthFocused="1dp"
            app:startIconDrawable="@drawable/ic_search">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/champRecherche"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSearch"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/groupeFiltres"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:chipSpacingHorizontal="8dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip android:id="@+id/filtreTous" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="@string/programmes_filtre_tous" />
            <com.google.android.material.chip.Chip android:id="@+id/filtreActifs" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/programmes_filtre_actifs" />
            <com.google.android.material.chip.Chip android:id="@+id/filtreTermines" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/programmes_filtre_termines" />
        </com.google.android.material.chip.ChipGroup>
    </LinearLayout>

    <TextView
        android:id="@+id/texteVide"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:gravity="center"
        android:text="@string/programmes_aucun"
        android:textColor="@color/fitzone_text_secondary"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listeProgrammes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/fitzone_background"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="16dp" />

    <include layout="@layout/view_bottom_navigation" />
</LinearLayout>
