<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fitzone_surface"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        style="@style/FitZone.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:title="@string/nutrition_titre" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/indicateurChargement"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true" />

    <TextView
        android:id="@+id/texteVide"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:gravity="center"
        android:text="@string/nutrition_aucun"
        android:textColor="@color/fitzone_text_secondary"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listeNutrition"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/fitzone_background"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="16dp" />

    <include layout="@layout/view_bottom_navigation" />
</LinearLayout>
