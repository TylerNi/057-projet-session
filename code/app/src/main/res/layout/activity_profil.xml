<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fitzone_surface"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        style="@style/FitZone.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:title="@string/profil_titre" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/indicateurChargement"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/fitzone_background"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imageProfil"
                    android:layout_width="82dp"
                    android:layout_height="82dp"
                    android:background="@drawable/bg_profile_image"
                    android:clipToOutline="true"
                    android:contentDescription="@string/inscription_photo"
                    android:padding="5dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_profile_placeholder" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/texteNomCompletProfil"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/fitzone_text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/texteCourrielResumeProfil"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/fitzone_text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/texteTelephoneResumeProfil"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/fitzone_text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/carteResumeProfil"
                style="@style/FitZone.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="14dp"
                    android:paddingBottom="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="@string/profil_progression"
                        android:textColor="@color/fitzone_text_secondary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp">

                            <TextView
                                android:id="@+id/texteSeancesReussiesProfil"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/profil_stat_indisponible"
                                android:textColor="@color/fitzone_primary"
                                android:textSize="22sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:gravity="center"
                                android:text="@string/profil_seances_reussies"
                                android:textColor="@color/fitzone_text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="46dp"
                            android:background="@color/fitzone_divider" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp">

                            <TextView
                                android:id="@+id/texteProgrammesTerminesProfil"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/profil_stat_indisponible"
                                android:textColor="@color/fitzone_primary"
                                android:textSize="22sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:gravity="center"
                                android:text="@string/profil_programmes_termines"
                                android:textColor="@color/fitzone_text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="46dp"
                            android:background="@color/fitzone_divider" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp">

                            <TextView
                                android:id="@+id/texteNoteMoyenneProfil"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/profil_stat_indisponible"
                                android:textColor="@color/fitzone_primary"
                                android:textSize="22sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:gravity="center"
                                android:text="@string/profil_note_moyenne"
                                android:textColor="@color/fitzone_text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/boutonModifierProfil"
                style="@style/FitZone.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="2dp"
                android:text="@string/profil_modifier" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/boutonDeconnexionProfil"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:minHeight="48dp"
                android:text="@string/profil_deconnexion"
                android:textColor="@color/statut_en_retard" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/carteEditionProfil"
                style="@style/FitZone.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/conteneurPrenom" style="@style/FitZone.TextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/profil_prenom">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/champPrenomProfil" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPersonName" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/conteneurNom" style="@style/FitZone.TextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="@string/profil_nom">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/champNomProfil" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPersonName" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout style="@style/FitZone.TextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="@string/profil_courriel" app:helperText="@string/profil_courriel_aide">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/champCourrielProfil" android:layout_width="match_parent" android:layout_height="wrap_content" android:enabled="false" android:inputType="textEmailAddress" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/conteneurTelephone" style="@style/FitZone.TextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="@string/profil_telephone">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/champTelephoneProfil" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="phone" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout style="@style/FitZone.TextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="@string/profil_photo">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/champPhotoProfil" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textUri" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout style="@style/FitZone.TextInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="@string/profil_mot_de_passe" app:endIconMode="password_toggle" app:helperText="@string/profil_mot_de_passe_aide">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/champMotDePasseProfil" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/boutonEnregistrerProfil"
                        style="@style/FitZone.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/profil_enregistrer" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/boutonAnnulerProfil"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:minHeight="48dp"
                        android:text="@string/profil_annuler"
                        android:textColor="@color/fitzone_text_secondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include layout="@layout/view_bottom_navigation" />
</LinearLayout>
