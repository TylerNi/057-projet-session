<resources>
    <style name="Base.Theme.FitZone" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/fitzone_primary</item>
        <item name="colorOnPrimary">@color/fitzone_surface</item>
        <item name="colorPrimaryContainer">@color/fitzone_primary_soft</item>
        <item name="colorOnPrimaryContainer">@color/fitzone_primary</item>
        <item name="colorSecondary">@color/fitzone_primary</item>
        <item name="colorSurface">@color/fitzone_surface</item>
        <item name="colorSurfaceContainer">@color/fitzone_surface_muted</item>
        <item name="colorOutline">@color/fitzone_border</item>
        <item name="android:colorAccent">@color/fitzone_primary</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:colorBackground">@color/fitzone_background</item>
        <item name="android:textColorPrimary">@color/fitzone_text_primary</item>
        <item name="android:textColorSecondary">@color/fitzone_text_secondary</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/fitzone_surface</item>
        <item name="android:navigationBarColor">@color/fitzone_surface</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/fitzone_surface</item>
    </style>

    <style name="Theme.FitZone" parent="Base.Theme.FitZone" />

    <style name="FitZone.SectionTitle" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">22dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">@color/fitzone_text_primary</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans</item>
    </style>

    <style name="FitZone.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/fitzone_surface</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/fitzone_border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="FitZone.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/fitzone_primary</item>
    </style>

    <style name="FitZone.Button.Secondary" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/fitzone_primary</item>
        <item name="backgroundTint">@color/fitzone_primary_soft</item>
    </style>

    <style name="FitZone.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/fitzone_surface</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/fitzone_primary</item>
        <item name="hintTextColor">@color/fitzone_text_secondary</item>
    </style>

    <style name="FitZone.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@drawable/divider_bottom</item>
        <item name="titleTextColor">@color/fitzone_text_primary</item>
        <item name="titleCentered">true</item>
        <item name="android:elevation">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="titleTextAppearance">@style/FitZone.Toolbar.Title</item>
    </style>

    <style name="FitZone.Toolbar.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/fitzone_text_primary</item>
    </style>

    <style name="FitZone.Shape.RoundedImage" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>
</resources>
